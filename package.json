{
	"name": "allo_carto",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"jest": {
		"preset": "jest-expo",
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.ts"
		]
	},
	"engines": {
		"node": "24.18.0"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "clear; reset; expo start --ios",
		"ios:multi": "node ./scripts/ios-multi.js",
		"web": "expo start --web",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "expo lint",
		"test": "jest --watchAll",
		"build-ios": "npx expo run:ios --configuration Release --device --no-bundler",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx,yml,yaml}": "prettier --write"
	},
	"private": true,
	"dependencies": {
		"@expo-google-fonts/material-symbols": "^0.4.42",
		"@expo/metro-runtime": "~58.0.15",
		"@expo/ui": "~58.0.23",
		"@react-native-masked-view/masked-view": "0.3.2",
		"expo": "^58.0.19",
		"expo-asset": "~58.0.18",
		"expo-audio": "~58.0.10",
		"expo-constants": "~58.0.13",
		"expo-font": "~58.0.10",
		"expo-glass-effect": "~58.0.5",
		"expo-haptics": "~58.0.7",
		"expo-image": "~58.0.17",
		"expo-linear-gradient": "~58.0.3",
		"expo-linking": "~58.0.14",
		"expo-router": "~58.0.26",
		"expo-speech": "~58.0.3",
		"expo-splash-screen": "~58.0.11",
		"expo-sqlite": "~58.0.14",
		"expo-status-bar": "~58.0.4",
		"expo-symbols": "~58.0.4",
		"expo-system-ui": "~58.0.6",
		"expo-web-browser": "~58.0.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-web": "^0.21.2",
		"react-native-worklets": "0.13.0"
	},
	"devDependencies": {
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "30.0.0",
		"@types/react": "~19.3.0",
		"eslint": "^9",
		"eslint-config-expo": "~58.0.4",
		"eslint-import-resolver-typescript": "^4.4.5",
		"husky": "^9.1.7",
		"jest": "~30.5.2",
		"jest-expo": "~58.0.12",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"typescript": "~6.0.3"
	}
}
