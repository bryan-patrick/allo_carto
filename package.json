{
	"name": "allo_carto",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"jest": {
		"preset": "jest-expo",
		"setupFilesAfterEnv": [
			"<rootDir>/jest.setup.ts"
		]
	},
	"engines": {
		"node": "24.18.0"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "clear; reset; expo start --ios",
		"ios:multi": "node ./scripts/ios-multi.js",
		"release": "npx expo run:ios --configuration Release --simulator \"iPhone 17 Pro\"",
		"web": "expo start --web",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "expo lint",
		"test": "jest --watchAll",
		"build-ios": "npx expo run:ios --configuration Release --device",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx,yml,yaml}": "prettier --write"
	},
	"private": true,
	"dependencies": {
		"@expo/metro-runtime": "~57.0.8",
		"@expo/vector-icons": "^15.0.2",
		"@react-native-masked-view/masked-view": "0.3.2",
		"expo": "~57.0.9",
		"expo-asset": "~57.0.7",
		"expo-audio": "~57.0.3",
		"expo-constants": "~57.0.7",
		"expo-font": "~57.0.1",
		"expo-haptics": "~57.0.1",
		"expo-image": "~57.0.1",
		"expo-linear-gradient": "~57.0.1",
		"expo-linking": "~57.0.4",
		"expo-router": "~57.0.9",
		"expo-splash-screen": "~57.0.5",
		"expo-sqlite": "~57.0.1",
		"expo-status-bar": "~57.0.1",
		"expo-symbols": "~57.0.1",
		"expo-system-ui": "~57.0.2",
		"expo-web-browser": "~57.0.2",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.2",
		"react-native-gesture-handler": "~3.1.0",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-web": "^0.21.2",
		"react-native-worklets": "0.10.1"
	},
	"devDependencies": {
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "29.5.14",
		"@types/react": "~19.2.4",
		"eslint": "^9",
		"eslint-config-expo": "~57.0.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"husky": "^9.1.7",
		"jest": "~29.7.0",
		"jest-expo": "~57.0.2",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"typescript": "~6.0.3"
	}
}
