{
	"expo": {
		"name": "allo_carto",
		"slug": "allo_carto",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./src/app/assets/images/icon.png",
		"scheme": "allocarto",
		"userInterfaceStyle": "automatic",
		"ios": {
			"deploymentTarget": "16.4",
			"supportsTablet": true,
			"requireFullScreen": true,
			"bundleIdentifier": "com.anonymous.allo-carto"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./src/app/assets/images/android-icon-foreground.png",
				"backgroundImage": "./src/app/assets/images/android-icon-background.png",
				"monochromeImage": "./src/app/assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"permissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.MODIFY_AUDIO_SETTINGS"
			]
		},
		"web": {
			"output": "static",
			"favicon": "./src/app/assets/images/favicon.png"
		},
		"plugins": [
			[
				"expo-router",
				{
					"headers": {
						"Cross-Origin-Embedder-Policy": "credentialless",
						"Cross-Origin-Opener-Policy": "same-origin"
					}
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./src/app/assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			],
			"expo-audio",
			"expo-sqlite",
			"expo-font",
			"expo-asset",
			"expo-status-bar",
			"expo-image",
			"expo-web-browser"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
